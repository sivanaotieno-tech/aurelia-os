.class public final Lcom/adincube/sdk/d/a/p;
.super Lcom/adincube/sdk/d/a/c;


# direct methods
.method public constructor <init>()V
    .locals 2

    const-string v0, "UNSUPPORTED_OS_VERSION"

    const-string v1, "AdinCube only shows ads for Android SDK >= 2.1 - Eclair."

    invoke-direct {p0, v0, v1}, Lcom/adincube/sdk/d/a/c;-><init>(Ljava/lang/String;Ljava/lang/String;)V

    return-void
.end method
